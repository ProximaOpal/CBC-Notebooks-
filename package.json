{
  "name": "cbc-notebooks",
  "private": true,
  "version": "1.0.0",
  "description": "CBC learning site for Kenya Grades 4–10",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/build.mjs && node scripts/verify-prerender.mjs",
    "verify:prerender": "node scripts/verify-prerender.mjs",
    "start": "python -m http.server 8080 --directory dist",
    "dev:next": "next dev",
    "build:next": "next build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.8.0",
    "@prisma/client": "^6.6.0",
    "bcryptjs": "^3.0.2",
    "framer-motion": "^12.6.3",
    "google-auth-library": "^9.15.1",
    "next": "^15.3.1",
    "next-auth": "5.0.0-beta.25",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^22.6.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.1",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^5.0.0"
  }
}
